# Application Environment Configuration
APP_ENV=development
LOG_LEVEL=INFO

# LLM Provider Configuration
# Supported options: gemini (Recommended Free Tier), ollama (Local Gemma 2 / Llama 3), openai, mock
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# Google Gemini API Configuration (Free tier: 15 RPM, 1M TPM, 1,500 RPD)
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Local Ollama Configuration (Fallback or Standalone offline LLM)
# Install Ollama (https://ollama.ai) and run: ollama pull gemma2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2

# Fallback Settings: If Gemini API is rate-limited (HTTP 429) or offline, automatically use Local
USE_FALLBACK=true

# OpenAI Configuration (Optional fallback/alternative)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Embedding Configuration
# Options: sentence-transformers (local neural embeddings) or tfidf (lightweight fallback)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage paths (relative to backend or absolute)
DATA_DIR=data

# Server
HOST=127.0.0.1
PORT=8000
